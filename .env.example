# Password for the /admin panel (set this as a secret named ADMIN_PASSWORD)
ADMIN_PASSWORD=change-me

# Managed automatically by Lovable Cloud — no need to fill these in manually
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Online payments (Razorpay) ───────────────────────────────────────────────
# All of these are SERVER-ONLY. Do NOT prefix them with VITE_ — anything with a VITE_
# prefix is bundled into the public browser JavaScript. Use rzp_test_* keys until you
# have tested end-to-end, then switch to rzp_live_* keys.
#
# Set to "razorpay" to enable "Pay Online" at checkout. Leave unset (or "offline") to keep
# the in-store-only checkout.
PAYMENT_PROVIDER=offline
# REQUIRED for online payments. Supabase Dashboard → Project Settings → API → service_role
# (or the "secret" key). It must be the real service-role key, NOT the publishable/anon key:
# the payment-confirmation SQL functions are callable by service_role only, so that nobody can
# mark an order paid from the browser. Online payment stays switched off until this is set.
SUPABASE_SERVICE_ROLE_KEY=change-me
# Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=change-me
# Razorpay Dashboard → Settings → Webhooks (the secret you type when creating the webhook).
# Webhook URL: https://<your-domain>/api/payments/razorpay-webhook
# Events: payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=change-me
